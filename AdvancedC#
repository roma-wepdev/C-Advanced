    // Q6: Remove all odd numbers from an ArrayList.
    private static void RemoveOddNumbers(ArrayList values)
    {
        for (int i = values.Count - 1; i >= 0; i--) if ((int)values[i]! % 2 != 0) values.RemoveAt(i);
    }
    private static void Q6() { ArrayList a = new ArrayList { 1, 2, 3, 4, 5, 6 }; RemoveOddNumbers(a); Console.WriteLine(string.Join(", ", a.ToArray())); }

    // Q7: Reverse a queue using a stack.
    private static Queue<T> ReverseQueue<T>(Queue<T> queue)
    {
        Stack<T> stack = new Stack<T>();
        while (queue.Count > 0) stack.Push(queue.Dequeue());
        while (stack.Count > 0) queue.Enqueue(stack.Pop());
        return queue;
    }
    private static void Q7() { Queue<int> q = new Queue<int>(new[] { 1, 2, 3, 4, 5 }); ReverseQueue(q); Console.WriteLine(string.Join(", ", q)); }

    // Q8: Check whether (), [], and {} are properly balanced and nested.
    private static bool AreParenthesesBalanced(string text)
    {
        Stack<char> stack = new Stack<char>();
        foreach (char c in text)
        {
            if (c == '(' || c == '[' || c == '{') stack.Push(c);
            else if (c == ')' || c == ']' || c == '}')
            {
                if (stack.Count == 0) return false;
                char open = stack.Pop();
                if ((c == ')' && open != '(') || (c == ']' && open != '[') || (c == '}' && open != '{')) return false;
            }
        }
        return stack.Count == 0;
    }
    private static void Q8() { Console.Write("Enter parentheses expression: "); Console.WriteLine(AreParenthesesBalanced(Console.ReadLine() ?? "") ? "Balanced" : "Not Balanced"); }

    // Q9: Bubble sort stops early if a pass makes no swaps.
    private static void OptimizedBubbleSort(int[] a)
    {
        for (int end = a.Length - 1; end > 0; end--)
        {
            bool swapped = false;
            for (int i = 0; i < end; i++) if (a[i] > a[i + 1]) { (a[i], a[i + 1]) = (a[i + 1], a[i]); swapped = true; }
            if (!swapped) break;
        }
    }
