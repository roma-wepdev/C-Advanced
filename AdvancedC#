    // Q1: Reverse an ArrayList in-place without ArrayList.Reverse().
    private static void Q1()
    {
        ArrayList values = new ArrayList { 1, 2, 3, 4, 5 };
        int left = 0, right = values.Count - 1;
        while (left < right) { object? temp = values[left]; values[left] = values[right]; values[right] = temp; left++; right--; }
        Console.WriteLine(string.Join(", ", values.ToArray()));
    }

